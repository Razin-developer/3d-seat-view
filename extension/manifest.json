{
  "manifest_version": 3,
  "name": "3D Seat View for BookMyShow & District",
  "version": "1.6.0",
  "description": "3D movie seat preview: see the view from your seat and find the best cinema seats before booking on BookMyShow or District.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://in.bookmyshow.com/*",
    "https://www.district.in/*",
    "https://in.bmscdn.com/*",
    "https://b.zmtcdn.com/*",
    "https://www.youtube-nocookie.com/*",
    "https://www.youtube.com/*",
    "https://*.pvrcinemas.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open 3D seat view",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://in.bookmyshow.com/*",
        "https://www.district.in/*",
        "https://www.pvrcinemas.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://in.bookmyshow.com/*",
        "https://www.district.in/*",
        "https://www.pvrcinemas.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
